          "created_by": "RUN /bin/sh -c set -eux; \t\tapk add --no-cache --virtual .build-deps \t\tca-certificates \t\tcoreutils \t\tcyrus-sasl-dev \t\tdpkg-dev dpkg \t\tgcc \t\tlibc-dev \t\tlibevent-dev \t\tlinux-headers \t\tmake \t\topenssl \t\topenssl-dev \t\tperl \t\tperl-io-socket-ssl \t\tperl-utils \t; \t\twget -O memcached.tar.gz \"$MEMCACHED_URL\"; \techo \"$MEMCACHED_SHA1  memcached.tar.gz\" | sha1sum -c -; \tmkdir -p /usr/src/memcached; \ttar -xzf memcached.tar.gz -C /usr/src/memcached --strip-components=1; \trm memcached.tar.gz; \t\tcd /usr/src/memcached; \t\tgnuArch=\"$(dpkg-architecture --query DEB_BUILD_GNU_TYPE)\"; \tcase \"$gnuArch\" in \t\tarm-*abihf) export ac_cv_c_alignment=need ;; \tesac; \t./configure \t\t--build=\"$gnuArch\" \t\t--enable-extstore \t\t--enable-proxy \t\t--enable-sasl \t\t--enable-sasl-pwdb \t\t--enable-tls \t; \tnproc=\"$(nproc)\"; \tmake -j \"$nproc\"; \t\tmake test PARALLEL=\"$nproc\" || make test; \t\tmake install; \t\tcd /; \trm -rf /usr/src/memcached; \t\trunDeps=\"$( \t\tscanelf --needed --nobanner --format '%n#p' --recursive /usr/local \t\t\t| tr ',' '\\n' \t\t\t| sort -u \t\t\t| awk 'system(\"[ -e /usr/local/lib/\" $1 \" ]\") == 0 { next } { print \"so:\" $1 }' \t)\"; \tapk add --no-network --virtual .memcached-rundeps $runDeps; \tapk del --no-network .build-deps; \t\tmemcached -V # buildkit",
