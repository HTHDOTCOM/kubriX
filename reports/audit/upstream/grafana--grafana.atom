    <content type="html">&lt;p&gt;&lt;a href=&quot;https://grafana.com/grafana/download/13.2.4&quot; rel=&quot;nofollow&quot;&gt;Download page&lt;/a&gt;&lt;br&gt;
&lt;a href=&quot;https://grafana.com/docs/grafana/latest/whatsnew/&quot; rel=&quot;nofollow&quot;&gt;What&#39;s new highlights&lt;/a&gt;&lt;/p&gt;
&lt;h3&gt;Security&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;Security: Fix &lt;a title=&quot;CVE-2026-15577&quot; data-hovercard-type=&quot;advisory&quot; data-hovercard-url=&quot;/advisories/GHSA-pm7c-5ghp-r9fq/hovercard&quot; href=&quot;https://github.com/advisories/GHSA-pm7c-5ghp-r9fq&quot;&gt;CVE-2026-15577&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Security: Fix &lt;a title=&quot;CVE-2026-33374&quot; data-hovercard-type=&quot;advisory&quot; data-hovercard-url=&quot;/advisories/GHSA-5mj5-pfmr-wxjp/hovercard&quot; href=&quot;https://github.com/advisories/GHSA-5mj5-pfmr-wxjp&quot;&gt;CVE-2026-33374&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Security: Fix &lt;a title=&quot;CVE-2026-93294&quot; data-hovercard-type=&quot;advisory&quot; data-hovercard-url=&quot;/advisories/GHSA-5wf9-m99g-f6xj/hovercard&quot; href=&quot;https://github.com/advisories/GHSA-5wf9-m99g-f6xj&quot;&gt;CVE-2026-93294&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Security: Fix &lt;a title=&quot;CVE-2026-95502&quot; data-hovercard-type=&quot;advisory&quot; data-hovercard-url=&quot;/advisories/GHSA-w2wx-887f-65f8/hovercard&quot; href=&quot;https://github.com/advisories/GHSA-w2wx-887f-65f8&quot;&gt;CVE-2026-95502&lt;/a&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;h3&gt;Features and enhancements&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;Alerting:&lt;/strong&gt; Strip sensitive headers from oauth2 cross-host redirects &lt;a href=&quot;https://github.com/grafana/grafana/pull/134433&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/grafana/grafana/pull/134433/hovercard&quot;&gt;#134433&lt;/a&gt;, &lt;a href=&quot;https://github.com/JacobsonMT&quot;&gt;@JacobsonMT&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Dashboard:&lt;/strong&gt; Fall back when collection deletion is unsupported &lt;a href=&quot;https://github.com/grafana/grafana/pull/134224&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/grafana/grafana/pull/134224/hovercard&quot;&gt;#134224&lt;/a&gt;, &lt;a href=&quot;https://github.com/bestend&quot;&gt;@bestend&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Git Sync:&lt;/strong&gt; Clarify repository links for pure Git &lt;a href=&quot;https://github.com/grafana/grafana/pull/134253&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/grafana/grafana/pull/134253/hovercard&quot;&gt;#134253&lt;/a&gt;, &lt;a href=&quot;https://github.com/ferruvich&quot;&gt;@ferruvich&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Provisioning:&lt;/strong&gt; Allow resource previews in unsynced folders &lt;a href=&quot;https://github.com/grafana/grafana/pull/134391&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/grafana/grafana/pull/134391/hovercard&quot;&gt;#134391&lt;/a&gt;, &lt;a href=&quot;https://github.com/grafana-writer%5Bbot%5D&quot;&gt;@grafana-writer[bot]&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Provisioning:&lt;/strong&gt; Reject invalid resource names before API calls &lt;a href=&quot;https://github.com/grafana/grafana/pull/133776&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/grafana/grafana/pull/133776/hovercard&quot;&gt;#133776&lt;/a&gt;, &lt;a href=&quot;https://github.com/grafana-writer%5Bbot%5D&quot;&gt;@grafana-writer[bot]&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Provisioning:&lt;/strong&gt; Show last checked time in Pull status &lt;a href=&quot;https://github.com/grafana/grafana/pull/134483&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/grafana/grafana/pull/134483/hovercard&quot;&gt;#134483&lt;/a&gt;, &lt;a href=&quot;https://github.com/ferruvich&quot;&gt;@ferruvich&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Provisioning:&lt;/strong&gt; Skip previews for pull requests from forks &lt;a href=&quot;https://github.com/grafana/grafana/pull/133799&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/grafana/grafana/pull/133799/hovercard&quot;&gt;#133799&lt;/a&gt;, &lt;a href=&quot;https://github.com/ferruvich&quot;&gt;@ferruvich&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Provisioning:&lt;/strong&gt; Stop PR previews when refs disappear &lt;a href=&quot;https://github.com/grafana/grafana/pull/133855&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/grafana/grafana/pull/133855/hovercard&quot;&gt;#133855&lt;/a&gt;, &lt;a href=&quot;https://github.com/ferruvich&quot;&gt;@ferruvich&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Provisioning:&lt;/strong&gt; Support legacy paths and diagnose missing source annotations &lt;a href=&quot;https://github.com/grafana/grafana/pull/133779&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/grafana/grafana/pull/133779/hovercard&quot;&gt;#133779&lt;/a&gt;, &lt;a href=&quot;https://github.com/grafana-writer%5Bbot%5D&quot;&gt;@grafana-writer[bot]&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Provisioning:&lt;/strong&gt; write terminal sync status back to repository on early sync-job failures and Respect Git Sync polling intervals after unchanged refs &lt;a href=&quot;https://github.com/grafana/grafana/pull/134478&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/grafana/grafana/pull/134478/hovercard&quot;&gt;#134478&lt;/a&gt;, &lt;a href=&quot;https://github.com/mustafasencer&quot;&gt;@mustafasencer&lt;/a&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;h3&gt;Bug fixes&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;CVE-2026-92539:&lt;/strong&gt; IAM: Fix: SCIM (Enterprise)&lt;/li&gt;
&lt;/ul&gt;</content>
