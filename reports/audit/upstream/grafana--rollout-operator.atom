  <entry>
    <id>tag:github.com,2008:Repository/385183546/v0.28.9</id>
    <updated>2026-08-17T20:48:39Z</updated>
    <link rel="alternate" type="text/html" href="https://github.com/grafana/rollout-operator/releases/tag/v0.28.9"/>
    <title>v0.28.9</title>
    <content type="html">&lt;p&gt;Docker images: &lt;code&gt;grafana/rollout-operator:v0.28.9&lt;/code&gt; and &lt;code&gt;grafana/rollout-operator-boringcrypto:v0.28.9&lt;/code&gt;&lt;/p&gt;
