    <title>operator: v0.12.0</title>
    <content type="html">&lt;h2&gt;&lt;a href=&quot;https://github.com/grafana/loki/compare/operator/v0.11.0...operator/v0.12.0&quot;&gt;0.12.0&lt;/a&gt; (2026-10-07)&lt;/h2&gt;
&lt;h3&gt;⚠ BREAKING CHANGES&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;operator:&lt;/strong&gt; Make schemas field required in storage spec (&lt;a href=&quot;https://github.com/grafana/loki/issues/24716&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/grafana/loki/pull/24716/hovercard&quot;&gt;#24716&lt;/a&gt;)&lt;/li&gt;
&lt;/ul&gt;
&lt;h3&gt;Features&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;operator:&lt;/strong&gt; Add CPU and memory utilization ratio telemetry recording rules (&lt;a href=&quot;https://github.com/grafana/loki/issues/23379&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/grafana/loki/pull/23379/hovercard&quot;&gt;#23379&lt;/a&gt;) (&lt;a href=&quot;https://github.com/grafana/loki/commit/4cc1c43ebcce6ddb9daa9c2790def321aa292118&quot;&gt;4cc1c43&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;operator:&lt;/strong&gt; Add support for full TLS compliance for OCP 5.0 (&lt;a href=&quot;https://github.com/grafana/loki/issues/24216&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/grafana/loki/pull/24216/hovercard&quot;&gt;#24216&lt;/a&gt;) (&lt;a href=&quot;https://github.com/grafana/loki/commit/8ce415aed5014313ea1b735ac38ec8410c522664&quot;&gt;8ce415a&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;operator:&lt;/strong&gt; Allow removal of expired schemas based on retention period (&lt;a href=&quot;https://github.com/grafana/loki/issues/24456&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/grafana/loki/pull/24456/hovercard&quot;&gt;#24456&lt;/a&gt;) (&lt;a href=&quot;https://github.com/grafana/loki/commit/16446f87a3210d8db1836017b42e4a539e51403a&quot;&gt;16446f8&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;operator:&lt;/strong&gt; Enable flush_on_shutdown and increase ingester terminationGracePeriodSeconds (&lt;a href=&quot;https://github.com/grafana/loki/issues/24325&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/grafana/loki/pull/24325/hovercard&quot;&gt;#24325&lt;/a&gt;) (&lt;a href=&quot;https://github.com/grafana/loki/commit/90c3797d8dfa463d0d6d7520e4f8d0d677a2467a&quot;&gt;90c3797&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;operator:&lt;/strong&gt; Make schemas field required in storage spec (&lt;a href=&quot;https://github.com/grafana/loki/issues/24716&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/grafana/loki/pull/24716/hovercard&quot;&gt;#24716&lt;/a&gt;) (&lt;a href=&quot;https://github.com/grafana/loki/commit/071148c19bc6051c6b2a7ec0027b54f893ea3275&quot;&gt;071148c&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;operator:&lt;/strong&gt; Update Loki operand to 3.7.7 (&lt;a href=&quot;https://github.com/grafana/loki/issues/24448&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/grafana/loki/pull/24448/hovercard&quot;&gt;#24448&lt;/a&gt;) (&lt;a href=&quot;https://github.com/grafana/loki/commit/04417f4851c5bf0bf826130242f2e083be516de9&quot;&gt;04417f4&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;operator:&lt;/strong&gt; Update Loki operand to 3.7.8 (&lt;a href=&quot;https://github.com/grafana/loki/issues/24743&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/grafana/loki/pull/24743/hovercard&quot;&gt;#24743&lt;/a&gt;) (&lt;a href=&quot;https://github.com/grafana/loki/commit/f1f1b23ee27717f2f753abab323086a4eb524bd4&quot;&gt;f1f1b23&lt;/a&gt;)&lt;/li&gt;
&lt;/ul&gt;
&lt;h3&gt;Bug Fixes&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;operator:&lt;/strong&gt; Align built-in certificate rotation defaults with OpenShift cert alert threshold (&lt;a href=&quot;https://github.com/grafana/loki/issues/24106&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/grafana/loki/pull/24106/hovercard&quot;&gt;#24106&lt;/a&gt;) (&lt;a href=&quot;https://github.com/grafana/loki/commit/32d3196e508634630ab41a156de530231cce3480&quot;&gt;32d3196&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;operator:&lt;/strong&gt; Downgrade golangci-lint to Go 1.26 (&lt;a href=&quot;https://github.com/grafana/loki/issues/24840&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/grafana/loki/pull/24840/hovercard&quot;&gt;#24840&lt;/a&gt;) (&lt;a href=&quot;https://github.com/grafana/loki/commit/7ba6f556340ded0e1d1f44af9816b3e494b1e6fa&quot;&gt;7ba6f55&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;operator:&lt;/strong&gt; Fix Go module and golangci-lint configuration (&lt;a href=&quot;https://github.com/grafana/loki/issues/24346&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/grafana/loki/pull/24346/hovercard&quot;&gt;#24346&lt;/a&gt;) (&lt;a href=&quot;https://github.com/grafana/loki/commit/101e8c4fece33f496e086f6369d738980aeba014&quot;&gt;101e8c4&lt;/a&gt;)&lt;/li&gt;
