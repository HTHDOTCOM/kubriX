&lt;li&gt;[CHANGE] adopt log/slog, drop go-kit/log &lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;2613013298&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/prometheus/blackbox_exporter/issues/1311&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/prometheus/blackbox_exporter/pull/1311/hovercard&quot; href=&quot;https://github.com/prometheus/blackbox_exporter/pull/1311&quot;&gt;#1311&lt;/a&gt;&lt;/li&gt;
